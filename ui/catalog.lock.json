    {
      "name": "pointer",
      "title": "Pointer gesture",
      "description": "Drive the active tool with mouse events, exactly like the mouse would. Coordinates are spread points (space \"doc\", default) or, in the desktop app, screen points (space \"screen\"). Example: a text frame with the type tool: {tool:\"type\", events:[{kind:\"down\",x:72,y:72},{kind:\"drag\",x:300,y:200},{kind:\"up\",x:300,y:200}]} leaves a caret in the new frame, ready for type_text. Returns the selection and the active tool.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "events": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clicks": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "On a down: presses in a row it completes (2 double, 3 triple…; default 1)"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "down",
                    "drag",
                    "up",
                    "move",
                    "doubleclick"
                  ]
                },
                "mods": {
                  "type": "object",
                  "properties": {
                    "alt": {
                      "type": "boolean"
                    },
                    "cmd": {
                      "type": "boolean"
                    },
                    "ctrl": {
                      "type": "boolean"
                    },
                    "shift": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "description": "Modifier keys held (cmd = Command on macOS / Ctrl elsewhere; alt = Option)"
                },
                "space": {
                  "type": "string",
                  "enum": [
                    "doc",
                    "screen"
                  ],
                  "description": "Coordinate space (default doc)"
                },
                "x": {
                  "type": "number",
                  "description": "x (pt)"
                },
                "y": {
                  "type": "number",
                  "description": "y (pt)"
                }
              },
              "required": [
                "kind",
                "x",
                "y"
              ],
              "additionalProperties": {}
            }
          },
          "mods": {
            "type": "object",
            "properties": {
              "alt": {
                "type": "boolean"
              },
              "cmd": {
                "type": "boolean"
              },
              "ctrl": {
                "type": "boolean"
              },
              "shift": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "description": "Modifier keys held (cmd = Command on macOS / Ctrl elsewhere; alt = Option)"
          },
          "tool": {
            "type": "string",
            "description": "Optional tool to select before the gesture"
          }
        },
        "required": [
          "events"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
