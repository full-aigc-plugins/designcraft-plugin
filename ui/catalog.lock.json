    {
      "name": "open_editor",
      "description": "Open DesignCraft's interactive editor. Optionally load a file inside the current workspace. This opens the UI; it does not automate editing commands.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Workspace-relative file path",
            "type": "string",
            "maxLength": 4096
          },
          "workspace": {
            "type": "string",
            "description": "Absolute workspace path; set before opening an editor session."
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://designcraft/panel.html",
          "surface": "editor",
          "visibility": [
            "model",
            "app"
          ]
        },
        "openai/ui": {
          "preferredModelDisplayMode": "fullscreen"
        }
      }
    },
    {
      "name": "list_commands",
      "title": "List commands",
      "description": "List DesignCraft commands: id, label, menu path, shortcut, parameter description and whether it can run right now. Every user-visible action is a command (frame.create, text.insert, type.char, style.paragraph.apply, layout.pages.insert, object.fill, transform.move, edit.undo…); run them with execute or batch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "enabledOnly": {
            "type": "boolean",
            "description": "Only commands that can run right now"
          },
          "filter": {
            "type": "string",
            "description": "Case-insensitive substring matched against id, label and menu path (e.g. \"frame\", \"style\", \"Layout\")"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "List commands",
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "execute",
      "title": "Execute command",
      "description": "Run any DesignCraft command by id with JSON params (ids and params from list_commands). Examples: {\"command\":\"frame.create\",\"params\":{\"rect\":[36,36,576,300],\"content\":\"text\",\"text\":\"Hello\"}} → {id, story}; {\"command\":\"type.char\",\"params\":{\"size\":24}}; {\"command\":\"edit.undo\"}. Coordinates are points in spread space. In the desktop app the UI-only commands (view.*, window.*, help.*, edit.dynamicSpelling, and app.* except app.links, which works everywhere) work too.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command id, e.g. frame.create"
          },
          "params": {
            "type": "object",
            "properties": {},
            "additionalProperties": {},
            "description": "Command parameters (see the `params` field of list_commands)"
          }
        },
        "required": [
          "command"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "Execute command",
        "readOnlyHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "batch",
      "title": "Execute commands",
      "description": "Run several commands in order, stopping at the first error. Returns each result; on failure also the failing index and message (earlier commands stay applied; use edit.undo to revert them). Later steps can use earlier results: a parameter string \"$N.path\" is replaced by that value of step N's result (0-based; \"$last.path\" for the previous step), e.g. after frame.create → {\"id\": 8, \"story\": 9}, {\"story\": \"$0.story\"} passes 9; \"${N.path}\" interpolates into longer strings. Other strings starting with $ stay as written; \"$$\" is a literal $ (\"$$1\" passes the GREP group $1). Give `commands`, or `script` text (one `command.id {json}` per line).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commands": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Command id"
                },
                "params": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": {},
                  "description": "Command parameters (see the `params` field of list_commands)"
                }
              },
              "required": [
                "command"
              ],
              "additionalProperties": {}
            },
            "description": "Commands to run in order"
          },
          "script": {
            "type": "string",
            "description": "Alternative to `commands`: lines of `command.id {json params}` (# comments allowed)"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": {}
      },
      "annotations": {
        "title": "Execute commands",
        "readOnlyHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
