{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:designcraft:source-release-lock:1",
  "title": "DesignCraft Skills source release lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "releaseTag",
    "commitSha",
    "sourceVersion",
    "skills",
    "files",
    "contentSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+/[^?#]+$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "commitSha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "sourceVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))(?:\\.(?:(?:0|[1-9][0-9]*)|(?:[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^skills/[a-z0-9-]+/.+\\.([A-Za-z0-9]+)$" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
