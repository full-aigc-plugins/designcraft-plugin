{
  "name": "designcraft",
  "version": "0.1.0-dev.20261111.1",
  "description": "海报、长文档、刊物和画册一次排好：母版、页码与出血统一处理，导出 PDF、IDML 或 EPUB。",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "DesignCraft（页面排版）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "designcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "DesignCraft",
    "zh-CN": "DesignCraft（页面排版）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "DesignCraft",
          "zh-CN": "DesignCraft（页面排版）"
        },
        "icon": "layout",
        "server": "designcraft-editor",
        "resourceUri": "ui://designcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
